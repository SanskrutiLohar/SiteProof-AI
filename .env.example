# ====================================================================
# SiteProof AI - Environment Configuration
# ====================================================================

# 1. Supabase Backend Connection
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Backend Secret (For Edge Functions / Server - NEVER expose in client code)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Gemini AI API Configuration
# Get your Gemini API key from https://aistudio.google.com/
# Can be supplied here or configured interactively in the app via AI Settings Modal
VITE_GEMINI_API_KEY=
